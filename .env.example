# Copy to .env and fill in. Never commit .env.

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://rfp:rfp_dev_password@localhost:5432/rfp

# Auth. JWT_SECRET must be random and at least 32 characters, for example:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# Language model (free tier). Get a key from Google AI Studio.
# LLM_MODELS is a comma-separated list, best first. Free-tier model names change often,
# so check the current names in AI Studio and use the same values as in your working .env.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODELS=
LLM_TIMEOUT_MS=45000

# Local embedding model (runs on your computer, no key). Use the value from your working .env.
EMBEDDING_MODEL=

# Shared password for the synthetic demo accounts (seed script). Use 12+ characters.
SEED_USER_PASSWORD=

# Interface only: where the Streamlit app finds the API (default shown)
# RFP_API_URL=http://127.0.0.1:8000
